{
  "name": "seance",
  "version": "0.1.0",
  "description": "Summon the ghost of whoever wrote this code",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "test": "vitest --run",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit",
    "start": "npm run crypt && npm run possessed && tsx src/server.ts",
    "crypt": "bash scripts/make-crypt.sh data/crypt",
    "possessed": "bash scripts/make-possessed.sh data/possessed",
    "contrast": "node scripts/contrast.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.32.1",
    "@hono/node-server": "^1.19.18",
    "@modelcontextprotocol/sdk": "1.32.2",
    "execa": "9.6.1",
    "hono": "4.13.16",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@fast-check/vitest": "0.1.6",
    "@types/node": "22.9.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "9.15.0",
    "fast-check": "3.23.2",
    "jsdom": "25.0.1",
    "prettier": "3.3.3",
    "tsx": "4.19.2",
    "typescript": "5.8.3",
    "vitest": "2.1.9"
  }
}

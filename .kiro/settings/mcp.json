{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem@2.0.1",
        "."
      ],
      "env": {}
    },
    "seance": {
      "command": "npx",
      "args": [
        "-y",
        "tsx",
        "src/mcp/server.ts"
      ],
      "env": {}
    },
    "git": {
      "command": "uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "."
      ],
      "env": {}
    }
  }
}

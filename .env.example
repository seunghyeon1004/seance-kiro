# GitHub personal access token for PR/issue enrichment (optional)
GITHUB_TOKEN=

# Timeout (ms) for individual git subprocess calls (default: 10000)
GIT_CALL_TIMEOUT_MS=10000

# Timeout (ms) for remote clone operations (default: 30000)
CLONE_TIMEOUT_MS=30000

# Maximum working-tree size in MB for remote clones (default: 200)
CLONE_MAX_MB=200

# Set to 1 to run integration tests that require real git and a network
INTEGRATION=

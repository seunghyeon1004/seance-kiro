# Required for the live ghost and the exorcism plan (the server never sends this key to the browser)
ANTHROPIC_API_KEY=
# Optional
PORT=3000
# ANTHROPIC_FIXTURE=1      # answer from recorded fixtures instead of calling the model (tests, offline demo)
# ALLOW_LOCAL=1            # allow local repo paths (never enable on a public host)
# REDACT_REJECTED=1        # hide the text of rejected claims (default: shown, struck through)
# SESSION_TTL_MS=1800000
# RATE_LIMIT_MAX=10        # max model-calling requests per client per window (default: 10)
# RATE_LIMIT_WINDOW_MS=600000  # sliding window duration in ms (default: 600000 = 10 minutes)
# MAX_MODEL_CALLS_PER_DAY=300  # global daily cap across all clients (default: 300)
# LLM_TIMEOUT_MS=30000     # model call timeout
# GIT_CALL_TIMEOUT_MS=10000  # timeout per git subprocess
# CLONE_TIMEOUT_MS=30000   # remote clone time limit
# CLONE_MAX_MB=200         # remote clone size limit

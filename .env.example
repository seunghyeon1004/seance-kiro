# Required for the live ghost and the exorcism plan (the server never sends this key to the browser)
ANTHROPIC_API_KEY=
# Optional
PORT=3000
# ANTHROPIC_FIXTURE=1      # tests only: answers come from test/fixtures by prompt hash. With it set the page cannot answer and the recorded answers are not served
# CRYPT_DIR=data/crypt     # where the sample "crypt" lives (built by npm run crypt)
# ALLOW_LOCAL=1            # allow local repo paths (never enable on a public host)
# REDACT_REJECTED=1        # hide the text of rejected claims (default: shown, struck through)
# POSSESSED_DIR=data/possessed  # where the hostile "possessed" sample lives (built by npm run possessed)
# SESSION_TTL_MS=1800000
# RATE_LIMIT_MAX=10        # max model-calling requests per client per window (default: 10)
# RATE_LIMIT_WINDOW_MS=600000  # sliding window duration in ms (default: 600000 = 10 minutes)
# MAX_MODEL_CALLS_PER_DAY=300  # global daily cap across all clients (default: 300)
# SUMMON_RATE_LIMIT_MAX=20     # max /api/summon requests per client per window (default: 20)
# SUMMON_RATE_LIMIT_WINDOW_MS=600000  # summon window in ms (default: 600000 = 10 minutes)
# WARD_RATE_LIMIT_MAX=60       # max /api/ward requests per client per window (default: 60)
# WARD_RATE_LIMIT_WINDOW_MS=600000    # ward window in ms (default: 600000 = 10 minutes)
# RECORDED_RATE_LIMIT_MAX=30   # max recorded answers and plans served per client per window (default: 30)
# RECORDED_RATE_LIMIT_WINDOW_MS=600000  # recorded window in ms (default: 600000 = 10 minutes)
# MAX_CONCURRENT_CLONES=3      # remote clones allowed at once; the samples take no slot (default: 3)
# SESSION_MAX=500              # sessions kept in memory; the oldest is dropped first (default: 500)
# LLM_TIMEOUT_MS=30000     # model call timeout for an answer
# LLM_PLAN_TIMEOUT_MS=90000  # model call timeout for an exorcism plan (a whole plan takes longer)
# RECORDINGS_DIR=recordings  # recorded sample answers served when the model is unavailable (default: recordings/)
# GIT_CALL_TIMEOUT_MS=10000  # timeout per git subprocess
# CLONE_TIMEOUT_MS=30000   # remote clone time limit
# CLONE_MAX_MB=200         # remote clone size limit, checked during the clone and again after the history is read
# SUMMON_DEADLINE_MS=60000 # one deadline for all git calls of a remote summon after the clone
# GITHUB_TIMEOUT_MS=5000 # one GitHub issue request (only with an API client's githubToken); skipped after the summon deadline
